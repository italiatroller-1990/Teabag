{{/* Pagination.

     Args: "Page" (*context.Pagination), "Target" (element id the swap
     replaces), "Fragment" (URL of the HTML fragment for that target, empty to
     swap from the full page), "Indicator" (element id of the busy indicator).

     Every control is a real link to a full page, so pagination works with
     JavaScript disabled, can be bookmarked and can be opened in a new tab.
     HTMX only upgrades the click into a fragment swap of "Target". */}}
{{$p := .Page}}
{{$target := .Target}}
{{$fragment := .Fragment}}
{{$indicator := .Indicator}}
{{with $p.Paginator}}
	{{if gt .TotalPages 1}}
		{{$params := $p.GetParams}}
		<nav class="x-pager" aria-label="{{ctx.Locale.Tr "x.pagination"}}">
			{{if .HasPrevious}}
				{{$href := print ctx.RootData.Link "?page=" .Previous}}{{if $params}}{{$href = print $href "&" $params}}{{end}}}
				<a class="x-btn x-btn-sm" rel="prev" href="{{$href}}"
					{{if $fragment}}hx-get="{{$fragment}}?page={{.Previous}}{{if $params}}&{{$params}}{{end}}"
					{{else}}hx-get="{{$href}}" hx-select="#{{$target}}"{{end}}
					hx-target="#{{$target}}" hx-swap="outerHTML"
					{{if $indicator}}hx-indicator="#{{$indicator}}"{{end}}>
					{{xIcon "x-chevron-left"}}{{ctx.Locale.Tr "repo.issues.previous"}}
				</a>
			{{else}}
				<span class="x-btn x-btn-sm is-disabled" aria-disabled="true">{{xIcon "x-chevron-left"}}{{ctx.Locale.Tr "repo.issues.previous"}}</span>
			{{end}}

			<span class="x-meta">{{ctx.Locale.Tr "x.page_of" .Current .TotalPages}}</span>

			{{if .HasNext}}
				{{$href := print ctx.RootData.Link "?page=" .Next}}{{if $params}}{{$href = print $href "&" $params}}{{end}}}
				<a class="x-btn x-btn-sm" rel="next" href="{{$href}}"
					{{if $fragment}}hx-get="{{$fragment}}?page={{.Next}}{{if $params}}&{{$params}}{{end}}"
					{{else}}hx-get="{{$href}}" hx-select="#{{$target}}"{{end}}
					hx-target="#{{$target}}" hx-swap="outerHTML"
					{{if $indicator}}hx-indicator="#{{$indicator}}"{{end}}>
					{{ctx.Locale.Tr "repo.issues.next"}}{{xIcon "x-chevron-right"}}
				</a>
			{{else}}
				<span class="x-btn x-btn-sm is-disabled" aria-disabled="true">{{ctx.Locale.Tr "repo.issues.next"}}{{xIcon "x-chevron-right"}}</span>
			{{end}}
		</nav>
	{{end}}
{{end}}
