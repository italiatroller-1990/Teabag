{{/* One directory level of the file tree, rendered as an HTML fragment.

     A directory owns an always-present (empty) child <ul> whose id is derived
     from the node path, so the expand button has a stable and unique swap
     target: with JavaScript the click fills it in place, without it the
     directory name is a plain link to the directory listing.

     A nested <ul> is a child of the <li> that owns it, so the HTML stays
     valid when several levels are open at once. */}}
<ul class="x-tree" data-x-path="{{.XTreePath}}">
	{{range $node := .XTreeNodes}}
		<li class="x-tree-item">
			{{if $node.IsDir}}
				<button type="button" class="x-tree-toggle" aria-expanded="false"
					aria-label="{{ctx.Locale.Tr "x.expand_folder" $node.Name}}"
					aria-controls="{{$node.ChildrenID}}"
					hx-get="{{$node.ChildrenURL}}"
					hx-target="#{{$node.ChildrenID}}"
					hx-swap="innerHTML">
					{{xIcon "x-chevron-right" 12}}{{xIcon "x-folder"}}
				</button>
				<a class="x-tree-name" href="{{$node.Link}}" title="{{$node.Name}}">{{$node.Name}}</a>
				<ul class="x-tree" id="{{$node.ChildrenID}}"></ul>
			{{else}}
				{{xIcon "x-file"}}
				<a class="x-tree-name" href="{{$node.Link}}" title="{{$node.Name}}">{{$node.Name}}</a>
			{{end}}
		</li>
	{{else}}
		<li class="x-tree-item x-meta">{{ctx.Locale.Tr "x.empty_directory"}}</li>
	{{end}}
</ul>
