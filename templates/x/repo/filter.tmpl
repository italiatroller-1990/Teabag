{{/* Filter the directory listing. A GET form works on its own; HTMX only turns
     typing into an in-place update of #x-file-list by asking the fragment
     endpoint for that one element.

     Both URLs are built from the same link, so the two paths filter the
     directory that is on screen: a filter typed in a subdirectory has to stay
     in that subdirectory. */}}
<form class="x-toolbar" method="get" action="{{.XTreeLink}}"
	hx-get="{{.XFileListLink}}"
	hx-target="#x-file-list"
	hx-swap="outerHTML"
	hx-trigger="input changed delay:300ms, search, submit"
	hx-indicator="#x-file-list-indicator">
	<label class="x-sr-only" for="x-file-filter">{{ctx.Locale.Tr "x.filter_files"}}</label>
	<input id="x-file-filter" type="search" name="filter" value="{{.XFileFilter}}" placeholder="{{ctx.Locale.Tr "x.filter_files"}}" autocomplete="off">
	<button type="submit" class="x-btn">{{xIcon "x-search"}}{{ctx.Locale.Tr "x.filter"}}</button>
	{{if .XFileFilter}}<a class="x-btn" href="{{.XTreeLink}}">{{ctx.Locale.Tr "filter.clear"}}</a>{{end}}
	<span class="x-spacer"></span>
	<a class="x-btn x-btn-sm" href="{{.XCommitsLink}}">
		{{xIcon "x-history"}}{{ctx.Locale.Tr "repo.file_history"}}
	</a>
</form>
<span id="x-file-list-indicator" class="htmx-indicator x-meta" role="status">{{ctx.Locale.Tr "x.loading"}}</span>
