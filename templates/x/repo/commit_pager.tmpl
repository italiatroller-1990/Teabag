{{/* Commit pagination. Plain links to a real page, so they work with JavaScript
     disabled; the fragment endpoint makes them an in-place update when it is on. */}}
<nav class="x-pager" aria-label="{{ctx.Locale.Tr "x.pagination"}}">
	{{/* the page size is part of the link, so the next page shows the same
	     number of commits instead of silently switching to the site default */}}
	{{$base := .XCommitsLink}}
	{{$prev := print $base "?page=" (Eval .XPage "-" 1) "&limit=" .XPageSize}}
	{{$next := print $base "?page=" (Eval .XPage "+" 1) "&limit=" .XPageSize}}
	{{$prevFragment := print .XCommitsListLink "?page=" (Eval .XPage "-" 1) "&limit=" .XPageSize}}
	{{$nextFragment := print .XCommitsListLink "?page=" (Eval .XPage "+" 1) "&limit=" .XPageSize}}
	{{if .XHasPrev}}
		<a class="x-btn x-btn-sm" rel="prev" href="{{$prev}}"
			hx-get="{{$prevFragment}}"
			hx-target="#x-list" hx-swap="outerHTML" hx-indicator="#x-list-indicator">
			{{xIcon "x-chevron-left"}}{{ctx.Locale.Tr "repo.issues.previous"}}
		</a>
	{{else}}
		<span class="x-btn x-btn-sm is-disabled" aria-disabled="true">{{xIcon "x-chevron-left"}}{{ctx.Locale.Tr "repo.issues.previous"}}</span>
	{{end}}
	<span class="x-meta">{{ctx.Locale.Tr "x.page_of" .XPage .XPageCount}}</span>
	{{if .XHasNext}}
		<a class="x-btn x-btn-sm" rel="next" href="{{$next}}"
			hx-get="{{$nextFragment}}"
			hx-target="#x-list" hx-swap="outerHTML" hx-indicator="#x-list-indicator">
			{{ctx.Locale.Tr "repo.issues.next"}}{{xIcon "x-chevron-right"}}
		</a>
	{{else}}
		<span class="x-btn x-btn-sm is-disabled" aria-disabled="true">{{ctx.Locale.Tr "repo.issues.next"}}{{xIcon "x-chevron-right"}}</span>
	{{end}}
</nav>
