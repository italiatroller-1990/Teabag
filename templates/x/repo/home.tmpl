{{template "x/base/head_start" .}}
	{{template "x/repo/header" .}}
	<div class="x-grid x-mt-4">
		<div>{{template "x/repo/tree" .}}</div>
		<div>
			{{/* the README carries its own heading, so the page heading is for
			     assistive technology only */}}
			<h1 class="x-sr-only">{{.Repository.Owner.Name}}/{{.Repository.Name}}</h1>
			{{template "x/repo/breadcrumb" .}}
			{{template "x/repo/filter" .}}
			{{template "x/repo/file_list" .}}
			{{if and .ReadmeExist (or .RenderAsMarkup .IsPlainText)}}
				{{template "x/repo/file" .}}
			{{end}}
		</div>
	</div>
{{template "x/base/head_end" .}}
