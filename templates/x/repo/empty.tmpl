{{template "x/base/head_start" .}}
	{{template "x/repo/header" .}}
	<div class="x-card x-card-body x-mt-4">
		<h1 class="x-page-title">{{xIcon "x-repo"}}{{ctx.Locale.Tr "repo.empty_message"}}</h1>
		{{if .Repository.IsBroken}}
			<p class="x-meta">{{ctx.Locale.Tr "repo.broken_message"}}</p>
		{{else}}
			<p class="x-meta">{{ctx.Locale.Tr "repo.no_branch"}}</p>
		{{end}}
		{{/* an empty repository has nothing to render in the experiment, so the
		     only action points at the page that can create the first commit */}}
		<p class="x-row">
			<a class="x-btn x-btn-primary" href="{{.RepoLink}}">{{xIcon "x-plus"}}{{ctx.Locale.Tr "repo.editor.new_file"}}</a>
			<a class="x-btn" href="{{.XRepoLink}}/">{{xIcon "x-arrow-left"}}{{ctx.Locale.Tr "x.back_to_repository"}}</a>
		</p>
	</div>
{{template "x/base/head_end" .}}
