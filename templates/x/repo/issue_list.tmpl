{{/* Issue rows. Rendered inline and as the target of the filter form's HTMX
     swap, so both paths share this markup. */}}
<div id="x-issue-list" class="x-card x-swap-fade">
	{{if .Issues}}
		<ul class="x-list">
			{{range .Issues}}
				<li>
					{{if .IsClosed}}{{xIcon "x-issue-closed" 20}}{{else}}{{xIcon "x-issue-opened" 20}}{{end}}
					<span class="x-badge">#{{.Index}}</span>
					<a class="x-list-title" href="{{$.XRepoLink}}/issues/{{.Index}}">{{.Title}}</a>
					<span class="x-spacer"></span>
					{{if .IsClosed}}
						<span class="x-badge">{{ctx.Locale.Tr "repo.issues.closed"}}</span>
					{{else}}
						<span class="x-badge x-badge-success">{{ctx.Locale.Tr "repo.issues.open"}}</span>
					{{end}}
					{{if .IsPull}}
						<span class="x-badge x-badge-accent">{{xIcon "x-git-pull-request" 12}}{{ctx.Locale.Tr "repo.pulls"}}</span>
					{{end}}
					<span class="x-meta">{{ctx.AvatarUtils.Avatar .Poster 20}} {{.Poster.Name}}</span>
					<span class="x-meta">{{DateUtils.TimeSince .UpdatedUnix}}</span>
				</li>
			{{end}}
		</ul>
	{{else}}
		{{template "x/base/empty" .}}
	{{end}}
</div>
